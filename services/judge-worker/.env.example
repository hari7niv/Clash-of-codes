# Judge Worker Environment Configuration

# Redis connection URL (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# BullMQ queue name (default: judge_submissions)
JUDGE_QUEUE_NAME=judge_submissions

# Number of concurrent jobs to process (default: 2)
# Increase this for horizontal scaling
WORKER_CONCURRENCY=2

# Judge0 API URL (default: http://localhost:2358)
JUDGE0_URL=http://localhost:2358

# Judge0 API key (optional, empty for community Judge0)
JUDGE0_API_KEY=

# Database URL (default: postgres://clash:clash@localhost:5440/clashofcode)
DATABASE_URL=postgres://clash:clash@localhost:5440/clashofcode

# Float tolerance for output comparison (default: 1e-9)
# Used when comparing floating-point test outputs
FLOAT_TOLERANCE=1e-9

# Log level (optional, for structured logging)
LOG_LEVEL=info
