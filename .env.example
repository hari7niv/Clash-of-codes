# ---------------------------------------------------------------------------
# Shared infrastructure
# ---------------------------------------------------------------------------
NODE_ENV=development

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://clash:clash@localhost:5440/clashofcode

# Redis (matchmaking queue, room state, socket.io adapter, BullMQ)
REDIS_URL=redis://localhost:6379

# Auth — MUST be identical across api & match-server so JWTs verify on both.
JWT_SECRET=dev-super-secret-change-me-in-prod
JWT_EXPIRES_IN=7d

# BullMQ queue name — MUST match between api (producer), match-server (producer)
# and judge-worker (consumer).
JUDGE_QUEUE_NAME=judge

# ---------------------------------------------------------------------------
# services/api  (stateless REST)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------------------
# services/match-server  (stateful — Socket.io)
# ---------------------------------------------------------------------------
MATCH_HOST=0.0.0.0
MATCH_PORT=4100
# Matchmaking pairing loop
PAIRING_INTERVAL_MS=1000
PAIRING_BASE_RATING_WINDOW=100
PAIRING_WINDOW_GROWTH_PER_SEC=50
PAIRING_MAX_RATING_WINDOW=1000
# Battle lifecycle timings
COUNTDOWN_MS=5000
MATCH_DURATION_MS=600000

# ---------------------------------------------------------------------------
# services/judge-worker  (BullMQ consumer -> Judge0)
# ---------------------------------------------------------------------------
JUDGE0_URL=http://localhost:2358
# Leave blank if your Judge0 instance is unauthenticated.
JUDGE0_AUTH_TOKEN=
JUDGE_WORKER_CONCURRENCY=4
# Output comparison tolerances
FLOAT_TOLERANCE=1e-6

# ---------------------------------------------------------------------------
# OAuth Providers (optional — leave blank to disable OAuth login)
# ---------------------------------------------------------------------------
# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth App: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback base URL (must match OAuth App settings)
OAUTH_CALLBACK_BASE=http://localhost:4000

# ---------------------------------------------------------------------------
# Email service (optional — leave blank to use console logging in dev)
# ---------------------------------------------------------------------------
# Provider: 'resend' | 'sendgrid' | 'console' (default in dev)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@clashofcode.dev
# Resend API key (https://resend.com)
RESEND_API_KEY=
# SendGrid API key (https://sendgrid.com)
SENDGRID_API_KEY=

